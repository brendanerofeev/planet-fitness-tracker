# Planet Fitness Credentials (Required)
PF_EMAIL=your-email@example.com
PF_PASSWORD=your-password

# Flask Configuration (Optional)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Scheduler Configuration (Optional)
LOG_INTERVAL=15

# Timezone (Optional)
TZ=Australia/Brisbane

# Database Configuration (Optional)
# DB_TYPE options: 'sqlite' or 'postgresql' (default: sqlite)
DB_TYPE=sqlite

# SQLite Configuration (used when DB_TYPE=sqlite)
# Leave empty to use default path (/app/data/gym_capacity.db in Docker, ./gym_capacity.db locally)
SQLITE_PATH=

# PostgreSQL Configuration (used when DB_TYPE=postgresql)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gym_capacity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Database Connection Pool Settings (Optional - PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Database Debugging (Optional)
DB_ECHO_SQL=false